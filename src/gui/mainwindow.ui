                       <item>
                        <widget class="QPushButton" name="btn1Dof">
                         <property name="styleSheet">
                          <string notr="true">/* DOF按钮基础样式 */
QPushButton#btn1Dof,
QPushButton#btn3Dof,
QPushButton#btn6Dof {
    min-height: 22px;
    background: transparent;
    border: 1px solid rgba(0, 100, 160, 0.3);
    color: rgb(58, 90, 122);
    font-size: 10px;
    font-weight: 500;
    padding: 0 6px;
}

/* DOF按钮悬停状态 */
QPushButton#btn1Dof:hover,
QPushButton#btn3Dof:hover,
QPushButton#btn6Dof:hover {
    border-color: rgb(136, 85, 255);
}

/* DOF按钮选中状态 - 修改为紫色 */
QPushButton#btn1Dof:checked,
QPushButton#btn3Dof:checked,
QPushButton#btn6Dof:checked {
    background-color: rgb(220, 210, 255);
    border-color: rgb(136, 85, 255);
    color: rgb(40, 60, 100);
    font-weight: bold;
}
</string>
                         </property>
                         <property name="text">
                          <string>1-DOF</string>
                         </property>
                        </widget>
