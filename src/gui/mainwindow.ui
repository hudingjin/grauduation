          <item>
           <widget class="QScrollArea" name="scrollArea">
            <property name="styleSheet">
             <string notr="true">/* 左侧面板滚动条 - 垂直 */
#leftPanel QScrollBar:vertical {
    background: #040f1c;
    width: 4px;
    margin: 0px;
    padding: 0px;
    border: none;
}

#leftPanel QScrollBar::handle:vertical {
    background: rgba(0, 212, 255, 0.5);
    border-radius: 2px;
    min-height: 30px;
}

#leftPanel QScrollBar::handle:vertical:hover {
    background: #00d4ff;
}

#leftPanel QScrollBar::add-line:vertical, 
#leftPanel QScrollBar::sub-line:vertical {
    height: 0px;
    background: transparent;
}

#leftPanel QScrollBar::add-page:vertical, 
#leftPanel QScrollBar::sub-page:vertical {
    background: transparent;
}

/* 左侧面板滚动条 - 水平 */
#leftPanel QScrollBar:horizontal {
    background: #040f1c;
    height: 4px;
    margin: 0px;
    padding: 0px;
    border: none;
}

#leftPanel QScrollBar::handle:horizontal {
    background: rgba(0, 212, 255, 0.5);
    border-radius: 2px;
    min-width: 30px;
}

#leftPanel QScrollBar::handle:horizontal:hover {
    background: #00d4ff;
}

#leftPanel QScrollBar::add-line:horizontal, 
#leftPanel QScrollBar::sub-line:horizontal {
    width: 0px;
    background: transparent;
}

#leftPanel QScrollBar::add-page:horizontal, 
#leftPanel QScrollBar::sub-page:horizontal {
    background: transparent;
}</string>
            </property>
