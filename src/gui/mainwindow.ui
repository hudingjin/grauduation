                             <item>
                              <widget class="QLineEdit" name="VXlineEdit">
                               <property name="styleSheet">
                                <string notr="true">/* 1. 默认状态：保持你的原样 */
QLineEdit#VXlineEdit {
    min-height: 26px; 
    background-color: rgba(2, 12, 24, 220); 
    color: white; 
    border: 2px solid rgba(0, 212, 255, 80); 
    border-radius: 3px; 
    padding: 0 8px;
}

/* 2. 获得焦点时：保持你的原样 */
QLineEdit#VXlineEdit:focus {
    border: 2px solid rgb(0, 212, 255);
}

/* 【新增】3. 错误状态：当 error 属性为 true 时，边框变红，背景稍微变深以示警告 */
QLineEdit#VXlineEdit[error=&quot;true&quot;] {
    border: 2px solid rgb(255, 0, 0);  /* 红色加粗边框 */
    background-color: rgba(20, 0, 0, 220); /* 背景微红，增强警示感 */
}

/* 【新增】4. 错误状态且获得焦点：用户正在修改错误的输入，保持红色边框提醒 */
QLineEdit#VXlineEdit[error=&quot;true&quot;]:focus {
    border: 2px solid rgb(255, 50, 50);
}</string>
                               </property>
