                       <item>
                        <widget class="QComboBox" name="syncComboBox">
                         <property name="styleSheet">
                          <string notr="true">QComboBox#syncComboBox {
    min-height: 24px;
    background: rgba(0, 212, 255, 0.04);
    border: 1px solid rgba(0, 100, 160, 0.3);
    color: rgb(0, 212, 255);
    font-size: 12px;
    padding: 0 8px;
}

QComboBox#syncComboBox:focus {
    border: 1px solid rgb(0, 212, 255);
}

QComboBox#syncComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 20px;
    border: none;
    background: transparent;
}

QComboBox#syncComboBox::down-arrow {
    image: none;
    width: 0px;
    height: 0px;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 6px solid rgb(0, 212, 255);
    margin-right: 6px;
}

QComboBox#syncComboBox QAbstractItemView {
    background-color: rgb(6, 20, 36);
    color: rgb(0, 212, 255);
    border: 1px solid rgba(0, 212, 255, 0.5);
    outline: 0;
    selection-background-color: rgba(136, 85, 255, 0.25);
    selection-color: white;
}

QComboBox#syncComboBox QAbstractItemView::item {
    min-height: 24px;
    padding: 4px 8px;
    background-color: transparent;
}

QComboBox#syncComboBox QAbstractItemView::item:hover {
    background-color: rgba(0, 212, 255, 0.08);
    color: white;
}

QComboBox#syncComboBox QAbstractItemView::item:selected {
    background-color: rgba(136, 85, 255, 0.25);
    color: white;
}</string>
