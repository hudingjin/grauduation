                    <string notr="true">QGroupBox#kinematicLimits{
    color: rgb(255, 196, 0);
    font-size: 12px;
    font-weight: 700;
    border: 1px solid rgba(0, 212, 255, 35);
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 16px;
    background-color: rgba(5, 18, 35, 180);
}

QGroupBox#kinematicLimits::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 10px;
    padding: 0 4px;
    color: rgb(255, 196, 0);
    background-color: rgba(5, 18, 35, 180);
}</string>
